<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conference Topic Selector Dashboard</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 3px; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

    <header class="bg-indigo-900 text-white shadow-md px-6 py-4 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold tracking-tight">ConferVote Pro</h1>
            <p class="text-xs text-indigo-200">15-Voter Decision Engine</p>
        </div>
        <div class="flex space-x-2">
            <button id="navAdminBtn" onclick="switchView('admin')" class="px-4 py-2 bg-indigo-700 hover:bg-indigo-600 rounded-md font-medium text-sm transition-colors shadow">🛠️ Admin Dashboard</button>
            <button id="navVoterBtn" onclick="switchView('voter')" class="px-4 py-2 bg-indigo-800 hover:bg-indigo-700 rounded-md font-medium text-sm transition-colors">👤 Voter Portal</button>
        </div>
    </header>

    <main class="max-w-7xl mx-auto p-4 md:p-6 grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-1 space-y-6">
            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-4">System Engine Status</h2>
                
                <div class="space-y-4">
                    <div>
                        <label class="text-xs font-medium text-slate-500 block mb-1">Active Voting Strategy</label>
                        <span id="statusVotingMode" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800">
                            🟢 Phase 1: Binary (Yes/No)
                        </span>
                    </div>
                    <div>
                        <label class="text-xs font-medium text-slate-500 block mb-1">Gate Status</label>
                        <span id="statusGate" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800">
                            📖 Polls Open
                        </span>
                    </div>
                    <div class="pt-2 border-t border-slate-100 grid grid-cols-2 gap-2 text-center">
                        <div class="bg-slate-50 p-2 rounded-lg">
                            <span id="statTotalTopics" class="block text-xl font-bold text-slate-700">0</span>
                            <span class="text-[10px] text-slate-400 font-medium uppercase">Total Topics</span>
                        </div>
                        <div class="bg-slate-50 p-2 rounded-lg">
                            <span id="statVotesCast" class="block text-xl font-bold text-slate-700">0</span>
                            <span class="text-[10px] text-slate-400 font-medium uppercase">Votes Logged</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400 mb-2">Simulate Active Voter</h3>
                <p class="text-xs text-slate-500 mb-4">Switch identity to see what different board members see, or simulate voting strings.</p>
                <select id="voterIdentitySelect" onchange="onVoterIdentityChange()" class="w-full bg-slate-50 border border-slate-200 rounded-lg p-2.5 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </select>
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">

            <div id="viewAdmin" class="space-y-6">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-lg font-bold text-slate-800 mb-1">Add Dynamic Conference Topics</h2>
                    <p class="text-xs text-slate-500 mb-4">Input structural concepts, keywords, or session themes for the pool.</p>
                    
                    <div class="flex gap-2">
                        <input type="text" id="topicInput" placeholder="e.g., Quantum Computing Architectures & Scaling" class="flex-1 bg-slate-50 border border-slate-200 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
                        <button onclick="addTopic()" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg transition-colors shadow-sm">Add Topic</button>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <h2 class="text-lg font-bold text-slate-800 mb-4">Session Matrix Control Panel</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 flex flex-col justify-between">
                            <div>
                                <h4 class="text-sm font-semibold text-slate-700 mb-1">Engine Optimization Strategy</h4>
                                <p class="text-xs text-slate-500 mb-3">Flip between binary validation filtering or ranked priority engines.</p>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="setVotingMode('binary')" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-indigo-600 bg-indigo-50 text-indigo-700" id="btnModeBinary">Binary Yes/No</button>
                                <button onclick="setVotingMode('ranked')" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-slate-200 text-slate-600 bg-white" id="btnModeRanked">Ranked Top 5</button>
                            </div>
                        </div>

                        <div class="p-4 bg-slate-50 rounded-xl border border-slate-100 flex flex-col justify-between">
                            <div>
                                <h4 class="text-sm font-semibold text-slate-700 mb-1">Gatekeeper Mechanics</h4>
                                <p class="text-xs text-slate-500 mb-3">Freeze incoming payloads to calculate consensus and metrics safely.</p>
                            </div>
                            <div class="flex gap-2">
                                <button onclick="setGateStatus(true)" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-emerald-600 text-white hover:bg-emerald-700 shadow-sm" id="btnGateOpen">Open Polls</button>
                                <button onclick="setGateStatus(false)" class="flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-slate-200 text-slate-700 hover:bg-slate-300" id="btnGateClose">Close & Show Data</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <div class="flex justify-between items-center mb-4">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Analytical Metrics Array (Back End)</h2>
                            <p class="text-xs text-slate-500">Live calculating node telemetry from all 15 board participants.</p>
                        </div>
                        <button onclick="seedMockData()" class="text-xs text-indigo-600 hover:text-indigo-800 font-semibold bg-indigo-50 px-3 py-1.5 rounded-md transition-colors">⚡ Seed Demo Votes</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm border-collapse">
                            <thead>
                                <tr class="border-b border-slate-100 text-slate-400 font-semibold text-xs uppercase tracking-wider bg-slate-50/50">
                                    <th class="py-3 px-4">Topic String Profile</th>
                                    <th class="py-3 px-4 text-center">Engine Metric Output</th>
                                    <th class="py-3 px-4 text-center">Status Visibility</th>
                                </tr>
                            </thead>
                            <tbody id="adminResultsTableBody" class="divide-y divide-slate-100">
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div id="viewVoter" class="hidden space-y-6">
                <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 border-b border-slate-100 pb-4 mb-6">
                        <div>
                            <h2 class="text-lg font-bold text-slate-800">Submit Ballot Evaluation</h2>
                            <p class="text-xs text-slate-500">Ballot changes save dynamically to system memory cache node matrix.</p>
                        </div>
                        <span id="voterPortalBadge" class="text-xs font-semibold px-3 py-1 bg-indigo-100 text-indigo-700 rounded-md">Voter: Board Member 1</span>
                    </div>

                    <div id="voterLockoutShield" class="hidden p-8 text-center bg-slate-50 rounded-xl border-2 border-dashed border-slate-200 my-4">
                        <span class="text-3xl block mb-2">🔒</span>
                        <h4 class="text-sm font-bold text-slate-700">Polling Gateway Deadlock</h4>
                        <p class="text-xs text-slate-400 max-w-sm mx-auto mt-1">The administrator has locked this gateway execution cycle to isolate results. No records can accept payloads now.</p>
                    </div>

                    <div id="voterInterfaceContainer" class="space-y-4">
                        </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        // --- Core Internal Real-Time State Matrix ---
        let appState = {
            currentView: 'admin',      // 'admin' | 'voter'
            votingMode: 'binary',       // 'binary' | 'ranked'
            isPollsOpen: true,
            selectedVoterId: 1,
            totalVoters: 15,
            topics: [
                { id: "t1", text: "Scaling AI Infrastructure for Production Architectures" },
                { id: "t2", text: "Zero-Trust Mesh Networks for Enterprise Frameworks" },
                { id: "t3", text: "UX/UI Conversion Strategies: Design System Scalability" },
                { id: "t4", text: "Distributed Database Topologies: Overcoming Latency Constraints" },
                { id: "t5", text: "Green Tech: Optimizing Energy Usage in Hyperscale Data Centers" }
            ],
            // Storage schemas: 
            // Binary format: { voterId: { topicId: true/false } }
            // Ranked format: { voterId: [topicId1, topicId2, topicId3, ...] (ordered top down) }
            votesBinary: {},
            votesRanked: {}
        };

        // Initialize empty tracking arrays for the 15 simulated board members
        for(let i = 1; i <= appState.totalVoters; i++) {
            appState.votesBinary[i] = {};
            appState.votesRanked[i] = [];
        }

        // --- Core App Life Cycle Mounting Hooks ---
        window.addEventListener('DOMContentLoaded', () => {
            populateVoterDropdown();
            syncUserInterfaceEngine();
        });

        function switchView(targetView) {
            appState.currentView = targetView;
            
            const adminBtn = document.getElementById('navAdminBtn');
            const voterBtn = document.getElementById('navVoterBtn');
            const viewAdmin = document.getElementById('viewAdmin');
            const viewVoter = document.getElementById('viewVoter');

            if(targetView === 'admin') {
                viewAdmin.classList.remove('hidden');
                viewVoter.classList.add('hidden');
                adminBtn.className = "px-4 py-2 bg-indigo-700 hover:bg-indigo-600 rounded-md font-medium text-sm transition-colors shadow text-white";
                voterBtn.className = "px-4 py-2 bg-indigo-800 hover:bg-indigo-700 rounded-md font-medium text-sm transition-colors text-white";
            } else {
                viewAdmin.classList.add('hidden');
                viewVoter.classList.remove('hidden');
                adminBtn.className = "px-4 py-2 bg-indigo-800 hover:bg-indigo-700 rounded-md font-medium text-sm transition-colors text-white";
                voterBtn.className = "px-4 py-2 bg-indigo-700 hover:bg-indigo-600 rounded-md font-medium text-sm transition-colors shadow text-white";
            }
            syncUserInterfaceEngine();
        }

        function populateVoterDropdown() {
            const select = document.getElementById('voterIdentitySelect');
            select.innerHTML = '';
            for(let i = 1; i <= appState.totalVoters; i++) {
                const opt = document.createElement('option');
                opt.value = i;
                opt.textContent = `Board Member Node #${i}`;
                select.appendChild(opt);
            }
        }

        function onVoterIdentityChange() {
            appState.selectedVoterId = parseInt(document.getElementById('voterIdentitySelect').value);
            syncUserInterfaceEngine();
        }

        // --- Engineering Logic Modifiers (State Setters) ---
        function addTopic() {
            const input = document.getElementById('topicInput');
            const val = input.value.trim();
            if(!val) return;

            const newId = 'topic_' + Date.now();
            appState.topics.push({ id: newId, text: val });
            input.value = '';
            syncUserInterfaceEngine();
        }

        function setVotingMode(mode) {
            appState.votingMode = mode;
            syncUserInterfaceEngine();
        }

        function setGateStatus(isOpen) {
            appState.isPollsOpen = isOpen;
            syncUserInterfaceEngine();
        }

        // Mutation Handlers for Voter Submissions
        function toggleBinaryVote(topicId, choice) {
            if(!appState.isPollsOpen) return;
            const currentVoter = appState.selectedVoterId;
            
            if(appState.votesBinary[currentVoter][topicId] === choice) {
                delete appState.votesBinary[currentVoter][topicId]; // Toggle out decision
            } else {
                appState.votesBinary[currentVoter][topicId] = choice;
            }
            syncUserInterfaceEngine();
        }

        function handleRankedMovement(topicId, action) {
            if(!appState.isPollsOpen) return;
            const currentVoter = appState.selectedVoterId;
            let currentList = [...appState.votesRanked[currentVoter]];

            if(action === 'add') {
                if(currentList.includes(topicId)) return;
                if(currentList.length >= 5) {
                    alert("System constraint configuration reached: Top 5 choice registry full.");
                    return;
                }
                currentList.push(topicId);
            } else if(action === 'remove') {
                currentList = currentList.filter(id => id !== topicId);
            } else if(action === 'up') {
                const idx = currentList.indexOf(topicId);
                if(idx > 0) {
                    [currentList[idx], currentList[idx - 1]] = [currentList[idx - 1], currentList[idx]];
                }
            } else if(action === 'down') {
                const idx = currentList.indexOf(topicId);
                if(idx !== -1 && idx < currentList.length - 1) {
                    [currentList[idx], currentList[idx + 1]] = [currentList[idx + 1], currentList[idx]];
                }
            }

            appState.votesRanked[currentVoter] = currentList;
            syncUserInterfaceEngine();
        }

        // Data Generator Seeding Functionality
        function seedMockData() {
            for(let voterId = 1; voterId <= appState.totalVoters; voterId++) {
                // Seed Binary Parameters
                appState.topics.forEach(t => {
                    const rand = Math.random();
                    if (rand > 0.6) appState.votesBinary[voterId][t.id] = 'yes';
                    else if (rand > 0.2) appState.votesBinary[voterId][t.id] = 'no';
                });

                // Seed Ranked Parameters
                let shuffled = [...appState.topics].sort(() => 0.5 - Math.random());
                let takeCount = Math.min(5, Math.floor(Math.random() * 6)); // Random choice counts up to 5
                appState.votesRanked[voterId] = shuffled.slice(0, takeCount).map(t => t.id);
            }
            syncUserInterfaceEngine();
        }

        // --- Core Application Render Sync Engine ---
        function syncUserInterfaceEngine() {
            // 1. Process Core System Global Statistics Top Labels
            document.getElementById('statTotalTopics').textContent = appState.topics.length;
            
            let totalVotesCounted = 0;
            if(appState.votingMode === 'binary') {
                for(let v in appState.votesBinary) {
                    totalVotesCounted += Object.keys(appState.votesBinary[v]).length;
                }
            } else {
                for(let v in appState.votesRanked) {
                    totalVotesCounted += appState.votesRanked[v].length;
                }
            }
            document.getElementById('statVotesCast').textContent = totalVotesCounted;

            // 2. Set Status Banner Badges
            const modeBadge = document.getElementById('statusVotingMode');
            if(appState.votingMode === 'binary') {
                modeBadge.textContent = "🟢 Phase 1: Binary (Yes/No)";
                modeBadge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800";
            } else {
                modeBadge.textContent = "📊 Phase 2: Ranked Choice (Top 5)";
                modeBadge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-800";
            }

            const gateBadge = document.getElementById('statusGate');
            if(appState.isPollsOpen) {
                gateBadge.textContent = "📖 Polls Open";
                gateBadge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-800";
            } else {
                gateBadge.textContent = "🔒 Polls Closed";
                gateBadge.className = "inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800";
            }

            // 3. Keep Admin Button Classes Highlighted Correctly
            const bBin = document.getElementById('btnModeBinary');
            const bRan = document.getElementById('btnModeRanked');
            if(appState.votingMode === 'binary') {
                bBin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-indigo-600 bg-indigo-50 text-indigo-700";
                bRan.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-slate-200 text-slate-600 bg-white hover:bg-slate-50";
            } else {
                bBin.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-slate-200 text-slate-600 bg-white hover:bg-slate-50";
                bRan.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all border border-indigo-600 bg-indigo-50 text-indigo-700";
            }

            const bGOn = document.getElementById('btnGateOpen');
            const bGOff = document.getElementById('btnGateClose');
            if(appState.isPollsOpen) {
                bGOn.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-emerald-600 text-white shadow-sm";
                bGOff.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-slate-100 text-slate-500 hover:bg-slate-200";
            } else {
                bGOn.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-slate-100 text-slate-500 hover:bg-slate-200";
                bGOff.className = "flex-1 py-2 text-xs font-bold rounded-lg transition-all bg-amber-600 text-white shadow-sm";
            }

            // Update user badge title in Portal
            document.getElementById('voterPortalBadge').textContent = `Voter ID Node Profile: Board Member #${appState.selectedVoterId}`;

            // 4. Structural Rendering Callouts
            renderAdminTable();
            renderVoterPortal();
        }

        // --- Sub-Component View Builder 1: Admin Data Aggregator Table ---
        function renderAdminTable() {
            const tbody = document.getElementById('adminResultsTableBody');
            tbody.innerHTML = '';

            if(appState.topics.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="text-center py-8 text-xs text-slate-400 font-medium">Empty analytical model array. Add structural topics above to begin mapping.</td></tr>`;
                return;
            }

            // Calculate analytical data aggregates based on active computational execution paradigm
            let analytics = {};
            appState.topics.forEach(t => { analytics[t.id] = { yes: 0, no: 0, score: 0, unvoted: 0 }; });

            if(appState.votingMode === 'binary') {
                for(let voterId = 1; voterId <= appState.totalVoters; voterId++) {
                    appState.topics.forEach(t => {
                        const decision = appState.votesBinary[voterId][t.id];
                        if(decision === 'yes') analytics[t.id].yes++;
                        else if(decision === 'no') analytics[t.id].no++;
                        else analytics[t.id].unvoted++;
                    });
                }
            } else {
                // Ranked choice weights system matrix parameters: 
                // Rank 1 = 5 pts, Rank 2 = 4 pts, Rank 3 = 3 pts, Rank 4 = 2 pts, Rank 5 = 1 pt.
                for(let voterId = 1; voterId <= appState.totalVoters; voterId++) {
                    const voterList = appState.votesRanked[voterId] || [];
                    voterList.forEach((topicId, index) => {
                        if(analytics[topicId]) {
                            const weightValue = 5 - index; 
                            analytics[topicId].score += weightValue;
                        }
                    });
                }
            }

            // Render calculations inside individual data table elements
            appState.topics.forEach(topic => {
                const metrics = analytics[topic.id];
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition-colors text-xs font-medium text-slate-700";

                // Column 1: Metadata String Profile
                const tdText = document.createElement('td');
                tdText.className = "py-3 px-4 font-semibold text-slate-800 max-w-xs md:max-w-md truncate";
                tdText.textContent = topic.text;
                tr.appendChild(tdText);

                // Column 2: Computed Metric Array Displays
                const tdMetric = document.createElement('td');
                tdMetric.className = "py-3 px-4 text-center";
                
                if(!appState.isPollsOpen) {
                    if(appState.votingMode === 'binary') {
                        tdMetric.innerHTML = `
                            <span class="inline-block text-emerald-600 bg-emerald-50 px-2 py-1 rounded font-bold mr-1">👍 ${metrics.yes} Y</span>
                            <span class="inline-block text-rose-600 bg-rose-50 px-2 py-1 rounded font-bold">👎 ${metrics.no} N</span>
                        `;
                    } else {
                        tdMetric.innerHTML = `<span class="inline-block text-purple-700 bg-purple-50 px-3 py-1 rounded-md font-bold text-sm">⭐ ${metrics.score} Pts</span>`;
                    }
                } else {
                    tdMetric.innerHTML = `<span class="text-slate-400 italic text-[11px]">Hidden till poll freeze</span>`;
                }
                tr.appendChild(tdMetric);

                // Column 3: Processing Consensus Pass Badges
                const tdPass = document.createElement('td');
                tdPass.className = "py-3 px-4 text-center";
                if(!appState.isPollsOpen) {
                    if(appState.votingMode === 'binary') {
                        // Binary passing validation rule logic threshold configuration (50% of group = 8 voters)
                        if(metrics.yes >= 8) {
                            tdPass.innerHTML = `<span class="px-2 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-emerald-100 text-emerald-800">Passes Cut (≥50%)</span>`;
                        } else {
                            tdPass.innerHTML = `<span class="px-2 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded bg-slate-200 text-slate-600">Dropped</span>`;
                        }
                    } else {
                        tdPass.innerHTML = `<span class="text-slate-400 font-normal">Calculated Priority</span>`;
                    }
                } else {
                    tdPass.innerHTML = `<span class="text-slate-400 italic text-[11px]">—</span>`;
                }
                tr.appendChild(tdPass);

                tbody.appendChild(tr);
            });
        }

        // --- Sub-Component View Builder 2: Interactive Voter Application Portal Engine ---
        function renderVoterPortal() {
            const shield = document.getElementById('voterLockoutShield');
            const container = document.getElementById('voterInterfaceContainer');
            
            container.innerHTML = '';

            if(!appState.isPollsOpen) {
                shield.classList.remove('hidden');
                container.classList.add('hidden');
                return;
            } else {
                shield.classList.add('hidden');
                container.classList.remove('hidden');
            }

            if(appState.topics.length === 0) {
                container.innerHTML = `<p class="text-slate-400 text-center text-xs py-4">No active payload targets available to compute ballots. Head back to Admin View to generate fields.</p>`;
                return;
            }

            const currentVoter = appState.selectedVoterId;

            // Render Route Pattern A: Binary Engine Interface Canvas
            if(appState.votingMode === 'binary') {
                appState.topics.forEach(topic => {
                    const voterRecord = appState.votesBinary[currentVoter] || {};
                    const activeChoice = voterRecord[topic.id];

                    const div = document.createElement('div');
                    div.className = "flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 p-4 bg-slate-50 border border-slate-100 rounded-xl hover:border-slate-200 transition-all shadow-2xs";
                    
                    const label = document.createElement('span');
                    label.className = "text-sm font-semibold text-slate-700 flex-1";
                    label.textContent = topic.text;
                    div.appendChild(label);

                    const btnGroup = document.createElement('div');
                    btnGroup.className = "flex gap-2 w-full sm:w-auto";

                    const yesBtn = document.createElement('button');
                    yesBtn.onclick = () => toggleBinaryVote(topic.id, 'yes');
                    yesBtn.className = `flex-1 sm:flex-initial px-4 py-2 text-xs font-bold rounded-lg transition-all border ${activeChoice === 'yes' ? 'bg-emerald-600 text-white border-emerald-600 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'}`;
                    yesBtn.textContent = "Yes, Keep It";

                    const noBtn = document.createElement('button');
                    noBtn.onclick = () => toggleBinaryVote(topic.id, 'no');
                    noBtn.className = `flex-1 sm:flex-initial px-4 py-2 text-xs font-bold rounded-lg transition-all border ${activeChoice === 'no' ? 'bg-rose-600 text-white border-rose-600 shadow-sm' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'}`;
                    noBtn.textContent = "No, Drop It";

                    btnGroup.appendChild(yesBtn);
                    btnGroup.appendChild(noBtn);
                    div.appendChild(btnGroup);
                    container.appendChild(div);
                });
            } 
            // Render Route Pattern B: Ranked Choice Sorting Controls Matrix Canvas
            else {
                const rankedIds = appState.votesRanked[currentVoter] || [];

                // Block Section 1: Ranked Choice Active Selections List
                const listWrapper = document.createElement('div');
                listWrapper.className = "mb-6 space-y-2";
                
                const wrapperHeader = document.createElement('h3');
                wrapperHeader.className = "text-xs font-bold uppercase tracking-wider text-slate-400 mb-2";
                wrapperHeader.textContent = "Your Top 5 Preference Stack (1st down to 5th)";
                listWrapper.appendChild(wrapperHeader);

                if(rankedIds.length === 0) {
                    const emptyMsg = document.createElement('div');
                    emptyMsg.className = "p-4 text-center text-xs italic text-slate-400 bg-slate-50 border border-dashed border-slate-200 rounded-xl";
                    emptyMsg.textContent = "Your preference profile stack is empty. Click the plus nodes below to stack preferences.";
                    listWrapper.appendChild(emptyMsg);
                } else {
                    rankedIds.forEach((id, index) => {
                        const targetTopic = appState.topics.find(t => t.id === id);
                        if(!targetTopic) return;

                        const div = document.createElement('div');
                        div.className = "flex items-center gap-3 p-3 bg-indigo-50/60 border border-indigo-100 rounded-xl";

                        const badge = document.createElement('span');
                        badge.className = "h-6 w-6 rounded-md bg-indigo-600 text-white font-bold text-xs flex items-center justify-center shrink-0";
                        badge.textContent = index + 1;
                        div.appendChild(badge);

                        const txt = document.createElement('span');
                        txt.className = "text-xs font-bold text-indigo-900 flex-1 truncate";
                        txt.textContent = targetTopic.text;
                        div.appendChild(txt);

                        // Position Shift Modifier Arrow Selectors Button Array
                        const ctrlGrp = document.createElement('div');
                        ctrlGrp.className = "flex gap-1";

                        const upBtn = document.createElement('button');
                        upBtn.onclick = () => handleRankedMovement(id, 'up');
                        upBtn.className = "p-1.5 bg-white border border-slate-200 text-slate-600 rounded hover:bg-slate-100 disabled:opacity-30 disabled:pointer-events-none text-xs font-bold";
                        upBtn.textContent = "▲";
                        if(index === 0) upBtn.disabled = true;

                        const downBtn = document.createElement('button');
                        downBtn.onclick = () => handleRankedMovement(id, 'down');
                        downBtn.className = "p-1.5 bg-white border border-slate-200 text-slate-600 rounded hover:bg-slate-100 disabled:opacity-30 disabled:pointer-events-none text-xs font-bold";
                        downBtn.textContent = "▼";
                        if(index === rankedIds.length - 1) downBtn.disabled = true;

                        const rmBtn = document.createElement('button');
                        rmBtn.onclick = () => handleRankedMovement(id, 'remove');
                        rmBtn.className = "p-1.5 bg-rose-50 border border-rose-100 text-rose-600 rounded hover:bg-rose-100 text-xs font-bold";
                        rmBtn.textContent = "✕";

                        ctrlGrp.appendChild(upBtn);
                        ctrlGrp.appendChild(downBtn);
                        ctrlGrp.appendChild(rmBtn);
                        div.appendChild(ctrlGrp);
                        listWrapper.appendChild(div);
                    });
                }
                container.appendChild(listWrapper);

                // Block Section 2: Unranked Unordered General Pool Options Selection Array
                const poolWrapper = document.createElement('div');
                poolWrapper.className = "space-y-2 border-t border-slate-100 pt-4";
                
                const poolHeader = document.createElement('h3');
                poolHeader.className = "text-xs font-bold uppercase tracking-wider text-slate-400 mb-2";
                poolHeader.textContent = "Available Topics Pool";
                poolWrapper.appendChild(poolHeader);

                const unrankedTopics = appState.topics.filter(t => !rankedIds.includes(t.id));

                if(unrankedTopics.length === 0) {
                    const completeMsg = document.createElement('p');
                    completeMsg.className = "text-xs text-slate-400 text-center py-2";
                    completeMsg.textContent = "All generated options mapped inside priority structure stack.";
                    poolWrapper.appendChild(completeMsg);
                } else {
                    unrankedTopics.forEach(topic => {
                        const div = document.createElement('div');
                        div.className = "flex justify-between items-center p-3 bg-slate-50 border border-slate-100 rounded-xl hover:bg-slate-100/50 transition-all";

                        const txt = document.createElement('span');
                        txt.className = "text-xs font-medium text-slate-700 flex-1 truncate pr-3";
                        txt.textContent = topic.text;
                        div.appendChild(txt);

                        const addBtn = document.createElement('button');
                        addBtn.onclick = () => handleRankedMovement(topic.id, 'add');
                        addBtn.className = "px-3 py-1.5 bg-white border border-slate-200 text-slate-700 text-xs font-bold rounded-lg hover:bg-indigo-600 hover:text-white hover:border-indigo-600 transition-all shadow-2xs shrink-0";
                        addBtn.textContent = "＋ Add to Stack";
                        
                        div.appendChild(addBtn);
                        poolWrapper.appendChild(div);
                    });
                }
                container.appendChild(poolWrapper);
            }
        }
    </script>
</body>
</html>
